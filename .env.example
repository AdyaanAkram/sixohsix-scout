# Copy to `.env` for docker compose, and/or `backend/.env` for local uvicorn.
# Never commit real secrets.

# ── Core ─────────────────────────────────────────────────
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=pbg_scout_local
JWT_SECRET=local-dev-only-rotate-before-any-real-data
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=INFO

# Set to 1 only when using compose profile local-db in production-like runs
ALLOW_COMPOSE_MONGO=0

# ── Mail ─────────────────────────────────────────────────
# Transactional email (staff invites, event access codes, password resets).
# development: stdout (prints the email to the server log — no account needed)
# production:  resend  (free tier: 3,000 emails/month, 100/day — ample for this)
#
# Resend setup (one-time):
#   1. Create a free account at https://resend.com
#   2. Add and verify your sending domain (e.g. 606athletics.com) via the DNS
#      records Resend shows you. Until a domain is verified you can only send
#      from onboarding@resend.dev to your own address — fine for a smoke test.
#   3. Create an API key → paste it into RESEND_API_KEY below.
#   4. Set MAIL_FROM to an address on the verified domain, e.g.
#      "60'6\" ID <noreply@606athletics.com>"
MAIL_PROVIDER=stdout
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

# ── Object storage ───────────────────────────────────────
# local (dev / single VPS volume) | s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
# R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Monitoring ───────────────────────────────────────────
SENTRY_DSN=

# ── Frontend build ───────────────────────────────────────
# Leave empty for same-origin /api via nginx (recommended in compose).
# Local CRA: http://127.0.0.1:8000
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
