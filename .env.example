# Copy to `.env` for docker compose, and/or `backend/.env` for local uvicorn.
# Never commit real secrets.

# ── Core ─────────────────────────────────────────────────
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=pbg_scout_local
JWT_SECRET=local-dev-only-rotate-before-any-real-data
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=INFO

# Set to 1 only when using compose profile local-db in production-like runs
ALLOW_COMPOSE_MONGO=0

# ── Mail ─────────────────────────────────────────────────
# development: stdout | production: resend
MAIL_PROVIDER=stdout
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

# ── Object storage ───────────────────────────────────────
# local (dev / single VPS volume) | s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
# R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Monitoring ───────────────────────────────────────────
SENTRY_DSN=

# ── Frontend build ───────────────────────────────────────
# Leave empty for same-origin /api via nginx (recommended in compose).
# Local CRA: http://127.0.0.1:8000
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
